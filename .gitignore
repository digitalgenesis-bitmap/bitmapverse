# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# reserved oracle secrets (nonces, unrevealed oracles, private reveal
# instructions) must never be tracked — see tests/oracle-secrets-git-protection.test.mjs
/oracle/reserved/

# derived/generated artifacts, not source
__pycache__/
*.pyc
/conformance/proof-a-v0.1/derived/
