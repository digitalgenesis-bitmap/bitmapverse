{
  "name": "bitmapverse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:core && npm run test:blind && npm run build && node --test tests/rendered-html.test.mjs",
    "test:core": "node --test tests/same-sat-latest-v01.test.mjs tests/shadow-council-v01.test.mjs",
    "test:resolver": "node --test tests/same-sat-latest-v01.test.mjs",
    "test:signals": "node --test tests/shadow-council-v01.test.mjs",
    "test:blind": "node --test tests/blind-package.test.mjs",
    "test:conformance": "node --test conformance/proof-a-v0.1/tests/conformance.test.mjs",
    "conformance:proof-a": "node conformance/proof-a-v0.1/run.mjs",
    "test:blind-v02": "node --test tests/blind-v02-package.test.mjs tests/blind-v02-contract.test.mjs",
    "test:blind-v021": "node --test tests/blind-v021-package.test.mjs tests/blind-v021-contract.test.mjs tests/oracle-secrets-git-protection.test.mjs",
    "test:blind-v022": "node --test tests/blind-v022-package.test.mjs tests/blind-v022-contract.test.mjs tests/blind-v022-corrections.test.mjs tests/blind-v022-manifest-integrity.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:all": "npm run test:core && npm run test:blind && npm run test:blind-v02 && npm run test:blind-v021 && npm run test:blind-v022 && npm run test:conformance && npm run lint && npm run build && node --test tests/rendered-html.test.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
